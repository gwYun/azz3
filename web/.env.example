# ── Public (browser-exposed) ────────────────────────────────────────────────
# Supabase project → Settings > API. Publishable key replaces the legacy anon
# key (legacy NEXT_PUBLIC_SUPABASE_ANON_KEY is still accepted as a fallback).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# ── Server-only (NEVER prefix with NEXT_PUBLIC) ──────────────────────────────
# Supabase Secret key (sb_secret_..., replaces service_role). Bypasses RLS —
# used only in server routes for credit/entitlement writes.
SUPABASE_SECRET_KEY=sb_secret_xxx

